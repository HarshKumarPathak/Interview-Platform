# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_platform

# Redis
REDIS_URL=redis://localhost:6379

# Realtime media
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_DEPLOYMENT=

# AI provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# Object storage (S3-compatible; AWS S3, Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=interview-platform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
