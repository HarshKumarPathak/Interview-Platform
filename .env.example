# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_platform

# Redis (reserved for realtime/queue integrations)
REDIS_URL=redis://localhost:6379

# Realtime media
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_DEPLOYMENT=
LIVEKIT_AGENT_SHARED_SECRET=

# AI provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
AI_ENGINE_URL=http://localhost:8000

# Realistic interviewer video avatars (server-side only)
# When configured, the realtime agent publishes a synchronized human-like interviewer video track.
# Supported provider values currently implemented: anam
INTERVIEW_AVATAR_PROVIDER=none
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_AVATAR_NAME=Interview Panel Lead
ANAM_SHOW_AI_DISCLOSURE=true

# Private object storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=interview-platform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Evaluation worker
EVALUATION_WORKER_SECRET=replace-with-a-long-random-secret
EVALUATION_WORKER_POLL_MS=2000
EVALUATION_WORKER_MAX_ATTEMPTS=3

# Observability
SENTRY_DSN=
